name: Build Incidents Service

on:
  push:
    branches: [main, develop]
    paths:
      - 'Final-Capstone/services/incidents-service/**'
      - '.github/workflows/ci-incidents-service.yml'
      - '.github/workflows/ci.yaml'
  pull_request:
    branches: [main, develop]
    paths:
      - 'Final-Capstone/services/incidents-service/**'
      - '.github/workflows/ci-incidents-service.yml'
      - '.github/workflows/ci.yaml'

permissions:
  contents: read
  packages: write
  security-events: write

jobs:
  build:
    uses: ./.github/workflows/ci.yaml
    permissions:
      contents: read
      packages: write
      security-events: write
    with:
      image_name: "incidents-service"
      docker_context: "Final-Capstone/services/incidents-service"
    secrets: inherit
